{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/worker/v1/run-manifest.schema.json",
  "title": "RunManifest",
  "type": "object",
  "description": "Phase 1 worker input manifest placeholder. Keep in sync with crates/contracts and adapter_common.contracts.",
  "required": ["run_id", "mode", "model", "property", "verifier_profile", "limits"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "mode": { "type": "string", "enum": ["full", "incremental", "audit"] }
  },
  "additionalProperties": true
}

