{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/worker/v1/result-manifest.schema.json",
  "title": "ResultManifest",
  "type": "object",
  "description": "Phase 1 worker output manifest placeholder. Keep in sync with crates/contracts and adapter_common.contracts.",
  "required": ["run_id", "status", "outcome", "metrics", "artifacts"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["completed", "failed", "timed_out"] },
    "outcome": { "type": "string", "enum": ["proved", "disproved", "inconclusive", "error"] }
  },
  "additionalProperties": true
}

